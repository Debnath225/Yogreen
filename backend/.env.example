NODE_ENV=development
PORT=4000
# Development uses in-memory storage by default. Set MONGODB_ENABLED=true to opt in.
# Production requires MongoDB and enables it by default.
MONGODB_ENABLED=false
# Set to a MongoDB replica-set URI when MongoDB is enabled.
# Local standalone MongoDB is not sufficient for atomic order/wallet transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/yogreen?replicaSet=rs0
MONGODB_DB=yogreen
# Comma separated origins allowed for browsers (web interface)
CORS_ORIGINS=http://localhost:3000
# Set true when running behind a load balancer / reverse proxy
TRUST_PROXY=false

# --- Secrets (REQUIRED in production) ---
OTP_SECRET=change-me-long-random-string
# RS256 keys (PEM, use \n for newlines). Generate: openssl genrsa -out priv.pem 2048 && openssl rsa -in priv.pem -pubout -out pub.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- OTP / SMS ---
# console = prints OTP in server log (dev only) | webhook = POST to your SMS gateway
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Returns devOtp in the API response. NEVER enable in production (server refuses to boot).
EXPOSE_DEV_OTP=true

# --- Push ---
PUSH_PROVIDER=console   # console | expo

# --- Bootstrap ---
SUPERADMIN_PHONE=+919000000000
