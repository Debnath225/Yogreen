{
  "expo": {
    "name": "YoGreen Rider",
    "slug": "yogreen-rider",
    "scheme": "yogreen-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#066B43" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.yogreen.rider" },
    "android": {
      "package": "com.yogreen.rider",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#066B43" },
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "plugins": ["expo-secure-store", "expo-notifications"],
    "extra": { "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" } }
  }
}
